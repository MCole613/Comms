// ===== FormLogic.gs =====

/**
 * FormLogic.gs — follows a Google Form's section branching.
 *
 * This one function runs on the server (to validate) AND is injected into the
 * browser (to show/hide sections as people answer), so both always agree.
 *
 * sections: [{ pageId, items: [{ id, kind, required, choices: [{ value, nav: {type, page} }] }],
 *              after: {type: 'CONTINUE'|'GO_TO_PAGE'|'SUBMIT'|'RESTART', page} }]
 * answers:  { itemId: string | string[] }
 *
 * Returns { indexes: [visible section indexes], complete: bool }.
 * "complete" is false while a branching question on the path is unanswered.
 */
function visibleSections(sections, answers) {
  var out = [];
  var i = 0;
  var guard = 0;
  while (i >= 0 && i < sections.length && guard++ < 100) {
    if (out.indexOf(i) >= 0) break;
    out.push(i);
    var sec = sections[i];
    var nav = sec.after || { type: 'CONTINUE' };
    var pending = false;
    for (var k = 0; k < sec.items.length; k++) {
      var item = sec.items[k];
      if (item.kind !== 'radio' && item.kind !== 'dropdown') continue;
      var branches = (item.choices || []).some(function (c) { return c.nav && c.nav.type !== 'CONTINUE'; });
      if (!branches) continue;
      var value = answers[item.id];
      var choice = null;
      for (var c = 0; c < item.choices.length; c++) {
        if (item.choices[c].value === value) choice = item.choices[c];
      }
      if (!choice) { pending = true; break; }
      if (choice.nav && choice.nav.type !== 'CONTINUE') nav = choice.nav;
    }
    if (pending) return { indexes: out, complete: false };
    if (nav.type === 'SUBMIT' || nav.type === 'RESTART') break;
    if (nav.type === 'GO_TO_PAGE') {
      var target = -1;
      for (var s = 0; s < sections.length; s++) if (sections[s].pageId === nav.page) target = s;
      i = target;
    } else {
      i = i + 1;
    }
  }
  return { indexes: out, complete: true };
}

if (typeof module !== 'undefined') module.exports = { visibleSections: visibleSections };

// ===== Data.gs =====

/**
 * Data.gs — storage. Each table is a tab in the app's data spreadsheet; every
 * cell is stored as plain text so dates stay 'YYYY-MM-DD'.
 */

function db_() {
  var id = PropertiesService.getScriptProperties().getProperty('DATA_SPREADSHEET_ID');
  if (!id) throw new Error('The app has not been set up yet. Run setup() from the Apps Script editor.');
  if (!db_.cache) db_.cache = SpreadsheetApp.openById(id);
  return db_.cache;
}

function sheet_(name) {
  var sh = db_().getSheetByName(name);
  if (!sh) throw new Error('Missing "' + name + '" table. Run setup() again.');
  return sh;
}

function readTable_(name) {
  var values = sheet_(name).getDataRange().getValues();
  if (values.length < 2) return [];
  var headers = values[0].map(function (h) { return String(h).trim(); });
  var keyFor = {};
  COLUMNS[name].forEach(function (c) { keyFor[c[1]] = c[0]; });
  var rows = [];
  for (var r = 1; r < values.length; r++) {
    if (values[r].join('') === '') continue;
    var o = { _row: r + 1 };
    COLUMNS[name].forEach(function (c) { o[c[0]] = ''; });
    headers.forEach(function (h, c) { if (keyFor[h]) o[keyFor[h]] = String(values[r][c] === null ? '' : values[r][c]); });
    rows.push(o);
  }
  return rows;
}

function rowOf_(name, o) {
  return COLUMNS[name].map(function (c) {
    var v = o[c[0]];
    return v === undefined || v === null ? '' : String(v);
  });
}

function appendRows_(name, objs) {
  if (!objs.length) return;
  var sh = sheet_(name);
  var range = sh.getRange(sh.getLastRow() + 1, 1, objs.length, COLUMNS[name].length);
  range.setNumberFormat('@');
  range.setValues(objs.map(function (o) { return rowOf_(name, o); }));
}

function updateRow_(name, o) {
  if (!o._row) throw new Error('Cannot update a row that was never saved.');
  var range = sheet_(name).getRange(o._row, 1, 1, COLUMNS[name].length);
  range.setNumberFormat('@');
  range.setValues([rowOf_(name, o)]);
}

function readSettings_() {
  var values = sheet_(TABLES.SETTINGS).getDataRange().getValues();
  var out = {};
  for (var i = 1; i < values.length; i++) {
    var k = String(values[i][0] || '').trim();
    if (k) out[k] = String(values[i][1] === null ? '' : values[i][1]).trim();
  }
  return out;
}

function writeSettings_(changes) {
  var sh = sheet_(TABLES.SETTINGS);
  var values = sh.getDataRange().getValues();
  Object.keys(changes).forEach(function (key) {
    for (var i = 1; i < values.length; i++) {
      if (String(values[i][0]).trim() === key) {
        sh.getRange(i + 1, 2).setNumberFormat('@').setValue(String(changes[key]));
        return;
      }
    }
    sh.appendRow([key, String(changes[key]), '']);
    values.push([key, changes[key], '']);
  });
}

function withLock_(fn) {
  var lock = LockService.getScriptLock();
  lock.waitLock(30000);
  try { return fn(); } finally { lock.releaseLock(); }
}

function nowText_() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm');
}

function todayIso_() {
  return Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function lc_(s) { return String(s || '').trim().toLowerCase(); }

function splitList_(s) {
  return String(s || '').split(',').map(function (x) { return x.trim(); }).filter(String);
}

function logActivity_(requestId, by, type, text, link) {
  appendRows_(TABLES.ACTIVITY, [{ at: nowText_(), requestId: requestId, by: by, type: type, text: text || '', link: link || '' }]);
}

// ===== People.gs =====

/**
 * People.gs — who's who. Roles: Communications (admin), Designer, Pastor, Staff.
 */

function readPeople_() {
  return readTable_(TABLES.PEOPLE).filter(function (p) {
    return p.email && !/^(no|false|n)$/i.test(p.active);
  }).map(function (p) { p.email = lc_(p.email); return p; });
}

function personByEmail_(email, people) {
  email = lc_(email);
  for (var i = 0; i < people.length; i++) if (people[i].email === email) return people[i];
  return null;
}

function roleHolder_(role, people) {
  for (var i = 0; i < people.length; i++) if (lc_(people[i].role) === lc_(role)) return people[i];
  return null;
}

function currentUser_(people) {
  if (!CURRENT_SESSION_) throw new Error('SIGNIN: Please sign in.');
  var email = lc_(CURRENT_SESSION_.email);
  var p = personByEmail_(email, people || readPeople_());
  var role = p ? p.role : ROLES.STAFF;
  return {
    email: email,
    name: p ? p.name : '',
    ministry: p ? p.ministry : '',
    role: role,
    known: !!(p && p.name),
    isAdmin: lc_(role) === lc_(ROLES.ADMIN),
    isDesigner: lc_(role) === lc_(ROLES.DESIGNER),
    isPastor: lc_(role) === lc_(ROLES.PASTOR)
  };
}

/** Email for a template owner ('Comms', 'Designer', 'Pastor', 'Leader'). */
function ownerEmail_(owner, request, people) {
  if (owner === 'Leader') return lc_(request.requesterEmail);
  var holder = roleHolder_(OWNER_ROLE[owner] || owner, people);
  if (holder) return holder.email;
  var admin = roleHolder_(ROLES.ADMIN, people);
  return admin ? admin.email : '';
}

function nameOf_(email, people) {
  var p = personByEmail_(email, people);
  return p && p.name ? p.name : String(email || '');
}

function emailsWithRole_(role, people) {
  return people.filter(function (p) { return lc_(p.role) === lc_(role); }).map(function (p) { return p.email; });
}

// ===== Auth.gs =====

/**
 * Auth.gs — email sign-in codes, so people outside the church Google domain
 * (volunteers, contractors, outside designers) can use the app.
 *
 *  1. Someone enters their email. If they're on the People list (or their
 *     address is in "Self sign-up domains"), the app emails a 6-digit code.
 *  2. They enter the code and get a session token, kept on their device for
 *     90 days. Every call from the page goes through call(), which checks it.
 */

var SESSION_DAYS = 90;
var CODE_MINUTES = 10;
var CODE_TRIES = 5;
var CODES_PER_HOUR = 5;

/** Set by call() for the length of one request. */
var CURRENT_SESSION_ = null;

function hash_(s) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(s))
    .map(function (b) { return ('0' + ((b + 256) % 256).toString(16)).slice(-2); }).join('');
}

function validEmail_(email) {
  return /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email);
}

/** May this email sign in? People list (active) or a self sign-up domain. */
function canSignIn_(email, people, settings) {
  if (personByEmail_(email, people)) return true;
  // Someone the admin deactivated stays out, even at a self sign-up domain.
  var listed = readTable_(TABLES.PEOPLE).some(function (x) { return lc_(x.email) === email; });
  if (listed) return false;
  var domain = email.split('@')[1];
  return splitList_(settings['Self sign-up domains']).map(lc_).indexOf(domain) >= 0;
}

/* ---------------- public sign-in API (no session needed) ---------------- */

function apiRequestCode(email) {
  email = lc_(email);
  if (!validEmail_(email)) throw new Error('Enter a valid email address.');
  var cache = CacheService.getScriptCache();
  var rlKey = 'rl:' + hash_(email);
  var sent = Number(cache.get(rlKey)) || 0;
  if (sent >= CODES_PER_HOUR) throw new Error('Too many codes requested. Please wait an hour and try again.');

  var settings = readSettings_();
  if (canSignIn_(email, readPeople_(), settings)) {
    var code = String(Math.floor(100000 + Math.random() * 900000));
    cache.put('otp:' + hash_(email), JSON.stringify({ h: hash_(email + ':' + code), t: 0 }), CODE_MINUTES * 60);
    cache.put(rlKey, String(sent + 1), 3600);
    send_(settings, {
      to: email,
      subject: 'Your sign-in code: ' + code,
      html: '<p>Your code for <b>' + esc_(settings['Brand header text'] || 'the Communications app') + '</b> is:</p>' +
        '<p style="font:700 28px Helvetica,Arial,sans-serif;letter-spacing:6px">' + code + '</p>' +
        '<p style="color:#66727f">It expires in ' + CODE_MINUTES + ' minutes. If you didn\'t ask for it, you can ignore this email.</p>'
    });
  }
  // Same answer either way, so the page doesn't reveal who has access.
  return { ok: true };
}

function apiVerifyCode(email, code) {
  email = lc_(email);
  code = String(code || '').replace(/\D/g, '');
  var cache = CacheService.getScriptCache();
  var key = 'otp:' + hash_(email);
  var raw = cache.get(key);
  if (!raw) throw new Error('That code has expired. Request a new one.');
  var rec = JSON.parse(raw);
  if (rec.h !== hash_(email + ':' + code)) {
    rec.t++;
    if (rec.t >= CODE_TRIES) { cache.remove(key); throw new Error('Too many wrong tries. Request a new code.'); }
    cache.put(key, JSON.stringify(rec), CODE_MINUTES * 60);
    throw new Error('That code isn\'t right. Check the email and try again.');
  }
  cache.remove(key);

  var token = createSession_(email);
  // Self sign-up: add them to People so they show up for admins.
  withLock_(function () {
    if (!readTable_(TABLES.PEOPLE).some(function (p) { return lc_(p.email) === email; })) {
      appendRows_(TABLES.PEOPLE, [{ email: email, name: '', role: ROLES.STAFF, ministry: '', active: 'Yes' }]);
    }
  });
  return { token: token };
}

function createSession_(email) {
  var token = (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '');
  var now = new Date();
  var expires = new Date(now.getTime() + SESSION_DAYS * 86400000);
  withLock_(function () {
    appendRows_(TABLES.SESSIONS, [{
      tokenHash: hash_(token), email: lc_(email), created: nowText_(),
      expires: Utilities.formatDate(expires, Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm')
    }]);
  });
  return token;
}

function sessionFor_(token) {
  if (!token || String(token).length < 32) return null;
  var h = hash_(token);
  var now = nowText_();
  var s = readTable_(TABLES.SESSIONS).filter(function (x) { return x.tokenHash === h; })[0];
  if (!s || s.revoked === 'Yes' || s.expires < now) return null;
  return s;
}

/** Sign out this device. */
function apiSignOut() {
  var s = CURRENT_SESSION_;
  if (!s || !s._row) return { ok: true };
  withLock_(function () { s.revoked = 'Yes'; updateRow_(TABLES.SESSIONS, s); });
  return { ok: true };
}

/* ---------------- the one entry point the page calls ---------------- */

/**
 * Every signed-in request goes through here: call(token, 'apiHome', []).
 * The api* functions refuse to run without a session set by this function.
 */
function call(token, name, args) {
  var api = apiMap_();
  if (!Object.prototype.hasOwnProperty.call(api, name)) throw new Error('Unknown action.');
  var s = sessionFor_(token);
  if (!s) throw new Error('SIGNIN: Please sign in again.');
  var people = readPeople_();
  var p = personByEmail_(s.email, people);
  // Removed or deactivated people lose access straight away.
  if (!p && !canSignIn_(s.email, people, readSettings_())) throw new Error('SIGNIN: Your access has been removed. Ask the communications team.');
  CURRENT_SESSION_ = s;
  try {
    return api[name].apply(null, args || []);
  } finally {
    CURRENT_SESSION_ = null;
  }
}

/** Removes expired sessions (runs with the weekly digest). */
function cleanupSessions_() {
  var now = nowText_();
  var sh = sheet_(TABLES.SESSIONS);
  var rows = readTable_(TABLES.SESSIONS);
  for (var i = rows.length - 1; i >= 0; i--) {
    if (rows[i].expires < now || rows[i].revoked === 'Yes') sh.deleteRow(rows[i]._row);
  }
}

// ===== Requests.gs =====

/**
 * Requests.gs — submitting, reviewing, changing and closing requests.
 */

var KIND_TO_TYPE = [
  [/^promoting/i, 'Promotion', 'promo'],
  [/^sermon series/i, 'Series', 'series'],
  [/^graphic design only/i, 'Design', 'design']
];

/* ---------------- validation (shared by every form) ---------------- */

function validateAnswers_(def, answers) {
  var path = visibleSections(def.sections, answers);
  if (!path.complete) throw new Error('Please answer every question that decides what comes next.');
  var clean = {};
  var missing = [];
  path.indexes.forEach(function (i) {
    def.sections[i].items.forEach(function (it) {
      var v = answers[it.id];
      if (Array.isArray(v)) v = v.map(String).filter(String);
      else if (v !== undefined && v !== null) v = String(v).trim();
      var empty = v === undefined || v === null || (Array.isArray(v) ? !v.length : v === '');
      if (empty) { if (it.required) missing.push(it.title); return; }
      if (it.choices) {
        (Array.isArray(v) ? v : [v]).forEach(function (x) {
          var ok = it.choices.some(function (c) { return c.value === x; });
          if (!ok) throw new Error('"' + x + '" is not an option for "' + it.title + '".');
        });
      }
      if (it.kind === 'date' && !/^\d{4}-\d{2}-\d{2}$/.test(v)) throw new Error('"' + it.title + '" needs a date.');
      clean[it.id] = Array.isArray(v) ? v : String(v).slice(0, it.kind === 'paragraph' ? 20000 : 500);
    });
  });
  if (missing.length) throw new Error('Please fill in: ' + missing.join('; '));
  return clean;
}

function formWithMinistries_(settings) {
  var def = JSON.parse(JSON.stringify(FORMS.request));
  var ministries = splitList_(settings['Ministries']);
  if (ministries.length) {
    def.sections[0].items.forEach(function (it) { if (it.id === 'ministry') it.choices = ministries.map(function (m) { return { value: m }; }); });
  }
  return def;
}

/* ---------------- submit ---------------- */

function apiSubmitRequest(answers, files) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  if (!user.known) throw new Error('Please tell us your name first (shown at the top of the New Request page).');
  var clean = validateAnswers_(formWithMinistries_(settings), answers || {});

  var kind = KIND_TO_TYPE.filter(function (k) { return k[0].test(clean.kind); })[0];
  if (!kind) throw new Error('Choose what you need.');
  var req = { requestType: kind[1] };
  Object.keys(clean).forEach(function (id) {
    var parts = id.split('.');
    if (parts.length === 2 && parts[0] !== kind[2]) return;
    var v = clean[id];
    req[parts[parts.length - 1]] = Array.isArray(v) ? v.join(', ') : v;
  });
  if (req.requestType !== 'Promotion') req.needsDesign = 'Yes';
  if (req.requestType === 'Series') {
    var w = parseInt(req.seriesWeeks, 10);
    if (!(w >= 1 && w <= 52)) throw new Error('"Number of weeks" should be a number between 1 and 52.');
    req.seriesWeeks = String(w);
    req.ministry = req.ministry || 'Sermon Series';
  }
  if (req.requestType === 'Design') req.whoFor = req.whoFor || '';

  var today = todayIso_();
  if (req.eventDate < today) throw new Error('That date has already passed.');

  var saved = withLock_(function () {
    var all = readTable_(TABLES.REQUESTS);
    req.requestId = nextRequestId_(all, today);
    req.submitted = nowText_();
    req.requester = user.name;
    req.requesterEmail = user.email;
    req.suggestedTier = suggestTier(req);
    req.tier = '';
    req.mode = modeFor(req.suggestedTier);
    req.status = STATUS.NEEDS_REVIEW;
    req.flags = runwayFlag(req.suggestedTier, today, req.eventDate);
    req.designRound = '0';
    req.updatedAt = req.submitted;
    appendRows_(TABLES.REQUESTS, [req]);
    logActivity_(req.requestId, user.email, 'Submitted', req.requestType + ' request submitted.');
    return req;
  });

  var warnings = [];
  try {
    var folder = ensureRequestFolder_(saved, settings, people);
    if (folder) {
      saved = findRequest_(saved.requestId);
      if (files && files.length) {
        saveFiles_(folder, files);
        logActivity_(saved.requestId, user.email, 'Files', files.length + ' file(s) attached.', folder.getUrl());
      }
    }
  } catch (e) { warnings.push('Files: ' + e.message); }
  try { notifySubmitted_(saved, settings, people); } catch (e) { warnings.push('Email: ' + e.message); }
  return { requestId: saved.requestId, warnings: warnings };
}

function nextRequestId_(all, today) {
  var prefix = 'REQ-' + today.slice(0, 4) + '-';
  var max = 0;
  all.forEach(function (r) { if (r.requestId.indexOf(prefix) === 0) max = Math.max(max, parseInt(r.requestId.slice(prefix.length), 10) || 0); });
  return prefix + ('00' + (max + 1)).slice(-3);
}

function findRequest_(requestId) {
  var r = readTable_(TABLES.REQUESTS).filter(function (x) { return x.requestId === requestId; })[0];
  if (!r) throw new Error('Request ' + requestId + ' was not found.');
  return r;
}

function saveRequest_(r) {
  r.updatedAt = nowText_();
  updateRow_(TABLES.REQUESTS, r);
}

function assertAdmin_(user) {
  if (!user.isAdmin) throw new Error('Only the communications team can do that.');
}

function assertOwnerOrAdmin_(user, r) {
  if (!user.isAdmin && lc_(r.requesterEmail) !== user.email) {
    throw new Error('Only the person who submitted this request (or the communications team) can do that.');
  }
}

/* ---------------- review (admin) ---------------- */

/**
 * decision: { action: 'approve' | 'needsInfo' | 'decline', tier, message, overrideCap }
 */
function apiReview(requestId, decision) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  assertAdmin_(user);
  decision = decision || {};
  var message = String(decision.message || '').trim().slice(0, 5000);

  var r = withLock_(function () {
    var r = findRequest_(requestId);
    if (r.status === STATUS.PLANNED || r.status === STATUS.DONE) throw new Error('This request has already been approved.');
    if (decision.action === 'needsInfo') {
      if (!message) throw new Error('Tell the requester what information you need.');
      r.status = STATUS.NEEDS_INFO;
    } else if (decision.action === 'decline') {
      r.status = STATUS.DECLINED;
    } else if (decision.action === 'approve') {
      var tier = TIERS.indexOf(decision.tier) >= 0 ? decision.tier : r.suggestedTier;
      if (tier === 'Level 1' && !decision.overrideCap) {
        var cap = Number(settings['Sprint cap per year']) || 0;
        var used = readTable_(TABLES.REQUESTS).filter(function (x) {
          return x.tier === 'Level 1' && x.eventDate.slice(0, 4) === r.eventDate.slice(0, 4) &&
            [STATUS.PLANNED, STATUS.DONE].indexOf(x.status) >= 0 && x.requestId !== r.requestId;
        }).length;
        if (cap && used >= cap) {
          throw new Error('CAP: ' + used + ' of ' + cap + ' Level 1 Sprints are already planned for ' + r.eventDate.slice(0, 4) + '. Approve anyway?');
        }
      }
      approve_(r, tier, settings, people, user);
    } else {
      throw new Error('Unknown review action.');
    }
    r.messageToRequester = message || r.messageToRequester;
    saveRequest_(r);
    logActivity_(r.requestId, user.email, 'Review', r.status + (r.tier ? ' as ' + r.tier : '') + (message ? ': ' + message : ''));
    return r;
  });

  try {
    if (r.status === STATUS.PLANNED) {
      syncCalendar_(r, settings);
      saveRequest_(r);
    } else if (r.status === STATUS.DECLINED) {
      removeCalendar_(r, settings);
    }
  } catch (e) { console.warn('Calendar: ' + e.message); }
  try { notifyReviewed_(r, settings, people); } catch (e) { console.warn('Email: ' + e.message); }
  return { status: r.status };
}

function approve_(r, tier, settings, people, user) {
  var today = todayIso_();
  r.tier = tier;
  r.mode = modeFor(tier);
  r.flags = runwayFlag(tier, today, r.eventDate);
  r.status = STATUS.PLANNED;
  r.approvedAt = nowText_();

  var designerTiers = splitList_(settings['Designer handles']);
  var plan = buildPlan(r, { today: today, designerTiers: designerTiers });
  var existing = readTable_(TABLES.TASKS).filter(function (t) { return t.requestId === r.requestId; }).length;
  var tasks = plan.map(function (p, i) {
    return {
      taskKey: r.requestId + '-' + ('0' + (existing + i + 1)).slice(-2),
      requestId: r.requestId, dueDate: p.dueDate, channel: p.channel, task: p.task, owner: p.owner,
      assigneeEmail: ownerEmail_(p.owner, r, people), status: TASK.OPEN, notes: p.notes, key: p.key
    };
  });
  // The brief is emailed automatically on approval, so that step is already done.
  tasks.forEach(function (t) {
    if (t.key === 'brief') { t.status = TASK.DONE; t.completedAt = nowText_(); t.completedBy = 'app'; }
  });
  appendRows_(TABLES.TASKS, tasks);

  if (/^yes/i.test(r.needsDesign)) {
    r.designState = DESIGN.BRIEFED;
    r.designStateSince = today;
    r.designRound = r.designRound || '0';
  }
}

/* ---------------- changes from the requester ---------------- */

function apiRequestChange(requestId, answers) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  var clean = validateAnswers_(FORMS.change, answers || {});
  var changes = [].concat(clean.changes || []);
  var cancel = changes.some(function (c) { return /^cancel/i.test(c); });
  var dateChange = changes.some(function (c) { return /date/i.test(c); });
  if (dateChange && !clean.newDate) throw new Error('Choose the new date.');

  var result = withLock_(function () {
    var r = findRequest_(requestId);
    assertOwnerOrAdmin_(user, r);
    if ([STATUS.CANCELLED, STATUS.DECLINED, STATUS.DONE].indexOf(r.status) >= 0) throw new Error('This request is closed.');
    var text = changes.join(', ') + (clean.newDate ? ' → ' + clean.newDate : '') + ': ' + clean.details;
    logActivity_(r.requestId, user.email, 'Change', text);

    var applied = false;
    if (cancel) {
      r.status = STATUS.CANCELLED;
      closeOpenTasks_(r.requestId, TASK.CANCELLED);
    } else if (dateChange) {
      if (r.status === STATUS.PLANNED) {
        r.requestedNewDate = clean.newDate; // the communications team applies it
      } else {
        r.eventDate = clean.newDate;
        r.flags = runwayFlag(r.suggestedTier, todayIso_(), r.eventDate);
        applied = true;
      }
    }
    saveRequest_(r);
    return { r: r, text: text, applied: applied };
  });

  try { if (cancel) removeCalendar_(result.r, settings); } catch (e) { console.warn(e.message); }
  try { notifyChange_(result.r, result.text, cancel, settings, people, user); } catch (e) { console.warn(e.message); }
  return { status: result.r.status, pendingDate: result.r.requestedNewDate || '' };
}

/** Admin applies a requested date change: open tasks shift by the same number of days. */
function apiApplyNewDate(requestId) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  assertAdmin_(user);
  var r = withLock_(function () {
    var r = findRequest_(requestId);
    if (!r.requestedNewDate) throw new Error('No date change is waiting.');
    var delta = daysBetweenIso(r.eventDate, r.requestedNewDate);
    var today = todayIso_();
    readTable_(TABLES.TASKS).forEach(function (t) {
      if (t.requestId !== requestId || t.status !== TASK.OPEN) return;
      var d = addDaysIso(t.dueDate, delta);
      t.dueDate = d < today ? today : d;
      updateRow_(TABLES.TASKS, t);
    });
    logActivity_(requestId, user.email, 'Change', 'Date moved from ' + prettyIso(r.eventDate) + ' to ' + prettyIso(r.requestedNewDate) + '; open tasks shifted ' + delta + ' days.');
    r.eventDate = r.requestedNewDate;
    r.requestedNewDate = '';
    r.flags = runwayFlag(r.tier || r.suggestedTier, today, r.eventDate);
    saveRequest_(r);
    return r;
  });
  try { syncCalendar_(r, settings); saveRequest_(r); } catch (e) { console.warn(e.message); }
  try { notifyDateApplied_(r, settings, people); } catch (e) { console.warn(e.message); }
  return { eventDate: r.eventDate };
}

function closeOpenTasks_(requestId, status) {
  readTable_(TABLES.TASKS).forEach(function (t) {
    if (t.requestId === requestId && t.status === TASK.OPEN) {
      t.status = status;
      updateRow_(TABLES.TASKS, t);
    }
  });
}

/* ---------------- results & status ---------------- */

function apiSaveResults(requestId, text) {
  var user = currentUser_();
  return withLock_(function () {
    var r = findRequest_(requestId);
    assertOwnerOrAdmin_(user, r);
    r.results = String(text || '').trim().slice(0, 10000);
    saveRequest_(r);
    logActivity_(requestId, user.email, 'Results', r.results);
    readTable_(TABLES.TASKS).forEach(function (t) {
      if (t.requestId === requestId && t.key === 'results' && t.status === TASK.OPEN && r.results) completeTask_(t, user.email);
    });
    refreshRequestStatus_(requestId);
    return { ok: true };
  });
}

function apiSetStatus(requestId, status) {
  var settings = readSettings_();
  var user = currentUser_();
  assertAdmin_(user);
  if ([STATUS.DONE, STATUS.CANCELLED, STATUS.PLANNED].indexOf(status) < 0) throw new Error('Unknown status.');
  var r = withLock_(function () {
    var r = findRequest_(requestId);
    r.status = status;
    if (status === STATUS.CANCELLED) closeOpenTasks_(requestId, TASK.CANCELLED);
    saveRequest_(r);
    logActivity_(requestId, user.email, 'Status', 'Marked ' + status);
    return r;
  });
  if (status === STATUS.CANCELLED) { try { removeCalendar_(r, settings); saveRequest_(r); } catch (e) { console.warn(e.message); } }
  return { status: r.status };
}

/** A planned request whose every task is finished becomes Done. */
function refreshRequestStatus_(requestId) {
  var tasks = readTable_(TABLES.TASKS).filter(function (t) { return t.requestId === requestId; });
  if (!tasks.length) return;
  var open = tasks.some(function (t) { return t.status === TASK.OPEN; });
  var r = findRequest_(requestId);
  if (!open && r.status === STATUS.PLANNED) { r.status = STATUS.DONE; saveRequest_(r); }
  else if (open && r.status === STATUS.DONE) { r.status = STATUS.PLANNED; saveRequest_(r); }
}

/* ---------------- tasks ---------------- */

function completeTask_(t, by) {
  t.status = TASK.DONE;
  t.completedAt = nowText_();
  t.completedBy = by;
  updateRow_(TABLES.TASKS, t);
}

function apiSetTaskDone(taskKey, done) {
  var user = currentUser_();
  return withLock_(function () {
    var t = readTable_(TABLES.TASKS).filter(function (x) { return x.taskKey === taskKey; })[0];
    if (!t) throw new Error('Task not found.');
    var r = findRequest_(t.requestId);
    var allowed = user.isAdmin || lc_(t.assigneeEmail) === user.email ||
      (t.owner === 'Leader' && lc_(r.requesterEmail) === user.email);
    if (!allowed) throw new Error('Only the person assigned (or the communications team) can update this task.');
    if (t.key === 'review' && done) throw new Error('Use Approve design or Request changes on the request page.');
    if (t.status === TASK.CANCELLED) throw new Error('This task was cancelled.');
    if (done) completeTask_(t, user.email);
    else { t.status = TASK.OPEN; t.completedAt = ''; t.completedBy = ''; updateRow_(TABLES.TASKS, t); }
    refreshRequestStatus_(t.requestId);
    return { status: t.status };
  });
}

/**
 * Admin hands tasks on a request to someone else (usually the ministry
 * leader who submitted it). taskKeys: the tasks to move. The new owner gets
 * one email listing what they now own.
 */
function apiReassignTasks(requestId, taskKeys, email) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  assertAdmin_(user);
  email = lc_(email);
  var to = personByEmail_(email, people);
  if (!to) throw new Error('Choose someone from the People list.');
  var keys = [].concat(taskKeys || []);
  if (!keys.length) throw new Error('There are no tasks to move.');

  var out = withLock_(function () {
    var r = findRequest_(requestId);
    var moved = [];
    readTable_(TABLES.TASKS).forEach(function (t) {
      if (t.requestId !== requestId || keys.indexOf(t.taskKey) < 0 || t.status !== TASK.OPEN) return;
      if (lc_(t.assigneeEmail) === email) return;
      t.assigneeEmail = email;
      updateRow_(TABLES.TASKS, t);
      moved.push(t);
    });
    if (moved.length) {
      logActivity_(requestId, user.email, 'Reassigned', moved.length + ' task' + (moved.length > 1 ? 's' : '') + ' given to ' + (to.name || email) + ': ' +
        moved.map(function (t) { return t.task; }).join('; '));
    }
    return { r: r, moved: moved };
  });

  if (out.moved.length && email !== user.email) {
    try { notifyReassigned_(out.r, out.moved, to, user, settings, people); } catch (e) { console.warn('Email: ' + e.message); }
  }
  return { moved: out.moved.length };
}

// ===== Design.gs =====

/**
 * Design.gs — files and the design review process.
 *
 * Briefed → (draft uploaded) In Review → Approved → (finals uploaded) Delivered
 *                     ↑            ↓ changes requested
 *                     └─ Revising ←┘   (beyond the included rounds → Feedback Held
 *                                        until the communications team releases it)
 */

/* ---------------- Drive folders ---------------- */

function folderIdFromUrl_(url) {
  var m = /\/folders\/([A-Za-z0-9_-]{10,})/.exec(String(url || '')) || /[?&]id=([A-Za-z0-9_-]{10,})/.exec(String(url || ''));
  return m ? m[1] : '';
}

/** Returns the request's Drive folder, creating it (and saving the link) if needed. */
function ensureRequestFolder_(r, settings, people) {
  if (r.designFolder) return DriveApp.getFolderById(folderIdFromUrl_(r.designFolder));
  var parentId = folderIdFromUrl_(settings['Drive parent folder']);
  var parent = parentId ? DriveApp.getFolderById(parentId) : DriveApp.getRootFolder();
  var folder = parent.createFolder(r.requestId + ' — ' + String(r.title || '').slice(0, 80));
  try { folder.setSharing(DriveApp.Access.DOMAIN_WITH_LINK, DriveApp.Permission.VIEW); } catch (e) { /* not a Workspace account */ }
  emailsWithRole_(ROLES.DESIGNER, people).forEach(function (e) {
    try { folder.addEditor(e); } catch (err) { console.warn('Share with ' + e + ': ' + err.message); }
  });
  // People outside the church domain can't use the domain link, so share with them directly.
  var domains = splitList_(settings['Self sign-up domains']).map(lc_);
  var requester = lc_(r.requesterEmail);
  if (requester && domains.indexOf(requester.split('@')[1]) < 0) {
    try { folder.addViewer(requester); } catch (err) { console.warn('Share with ' + requester + ': ' + err.message); }
  }
  withLock_(function () {
    var fresh = findRequest_(r.requestId);
    fresh.designFolder = folder.getUrl();
    saveRequest_(fresh);
  });
  r.designFolder = folder.getUrl();
  return folder;
}

function saveFiles_(folder, files) {
  if (files.length > 15) throw new Error('Please upload 15 files or fewer at a time.');
  return files.map(function (f) {
    var bytes = Utilities.base64Decode(String(f.data || ''));
    if (bytes.length > MAX_FILE_BYTES) throw new Error('"' + f.name + '" is larger than 10 MB. Put it in the Drive folder directly.');
    var file = folder.createFile(Utilities.newBlob(bytes, f.mimeType || 'application/octet-stream', String(f.name || 'upload').slice(0, 200)));
    return { name: file.getName(), url: file.getUrl() };
  });
}

/* ---------------- helpers ---------------- */

function designerFor_(r, settings, people) {
  var byDesigner = splitList_(settings['Designer handles']).map(lc_).indexOf(lc_(r.tier || r.suggestedTier)) >= 0;
  var holder = roleHolder_(byDesigner ? ROLES.DESIGNER : ROLES.ADMIN, people) || roleHolder_(ROLES.ADMIN, people);
  return { email: holder ? holder.email : '', name: holder ? holder.name : '', owner: byDesigner ? 'Designer' : 'Comms' };
}

function canDesign_(user, r, settings, people) {
  return user.isAdmin || user.isDesigner;
}

function tasksFor_(requestId) {
  return readTable_(TABLES.TASKS).filter(function (t) { return t.requestId === requestId; });
}

function addTask_(r, fields) {
  var n = tasksFor_(r.requestId).length + 1;
  var t = {
    taskKey: r.requestId + '-' + (fields.suffix || ('X' + n)),
    requestId: r.requestId, status: TASK.OPEN, notes: '', channel: 'Design'
  };
  Object.keys(fields).forEach(function (k) { if (k !== 'suffix') t[k] = fields[k]; });
  appendRows_(TABLES.TASKS, [t]);
  return t;
}

function setDesignState_(r, state) {
  r.designState = state;
  r.designStateSince = todayIso_();
}

/* ---------------- uploads ---------------- */

/**
 * stage: 'draft' (ready for the requester to review), 'final' (finished files)
 *        or 'file' (just add files to the folder).
 */
function apiUploadFiles(requestId, files, stage) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  var r = findRequest_(requestId);
  var designing = canDesign_(user, r, settings, people);
  var owns = lc_(r.requesterEmail) === user.email;
  if (!designing && !owns) throw new Error('Only the requester, the designer or the communications team can add files.');
  if ((stage === 'draft' || stage === 'final') && !designing) throw new Error('Only the designer or the communications team can deliver designs.');
  if (!files || !files.length) throw new Error('Choose at least one file.');

  var folder = ensureRequestFolder_(r, settings, people);
  var saved = saveFiles_(folder, files);
  var names = saved.map(function (f) { return f.name; }).join(', ');
  var today = todayIso_();
  var reviewDays = Number(settings['Review window days']) || 3;

  var out = withLock_(function () {
    var r = findRequest_(requestId);
    var tasks = tasksFor_(requestId);
    var round = Number(r.designRound) || 0;
    var review = null;

    if (stage === 'draft') {
      // Close the step that produced this draft.
      tasks.forEach(function (t) {
        if (t.status !== TASK.OPEN) return;
        if ((round === 0 && t.key === 'draft') || (round > 0 && t.key === 'revision')) completeTask_(t, user.email);
      });
      // Open (or re-date) the requester's review step.
      if (round === 0) {
        review = tasks.filter(function (t) { return t.key === 'review' && t.status === TASK.OPEN; })[0];
      }
      if (review) {
        review.dueDate = addDaysIso(today, reviewDays);
        updateRow_(TABLES.TASKS, review);
      } else {
        review = addTask_(r, {
          suffix: 'V' + round, dueDate: addDaysIso(today, reviewDays), owner: 'Leader', key: 'review',
          assigneeEmail: lc_(r.requesterEmail),
          task: round === 0 ? 'Review the first draft: approve or request changes' : 'Review the Round ' + round + ' update: approve or request changes'
        });
      }
      setDesignState_(r, DESIGN.IN_REVIEW);
    } else if (stage === 'final') {
      tasks.forEach(function (t) { if (t.status === TASK.OPEN && t.key === 'final') completeTask_(t, user.email); });
      setDesignState_(r, DESIGN.DELIVERED);
    }
    saveRequest_(r);
    logActivity_(requestId, user.email, stage === 'draft' ? 'Draft' : stage === 'final' ? 'Final files' : 'Files',
      (stage === 'draft' ? (round ? 'Round ' + round + ' update' : 'First draft') + ' uploaded: ' : stage === 'final' ? 'Final files delivered: ' : 'Added: ') + names,
      folder.getUrl());
    refreshRequestStatus_(requestId);
    return { r: r, review: review };
  });

  try {
    if (stage === 'draft') notifyDraftReady_(out.r, out.review, settings, people);
    if (stage === 'final') notifyFinalDelivered_(out.r, settings, people);
  } catch (e) { console.warn('Email: ' + e.message); }
  return { count: saved.length, designState: out.r.designState };
}

/* ---------------- requester decisions ---------------- */

function apiApproveDesign(requestId) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  var r = withLock_(function () {
    var r = findRequest_(requestId);
    assertOwnerOrAdmin_(user, r);
    if (r.designState !== DESIGN.IN_REVIEW) throw new Error('There is no draft waiting for review.');
    tasksFor_(requestId).forEach(function (t) {
      if (t.status === TASK.OPEN && (t.key === 'review' || t.key === 'checkin')) completeTask_(t, user.email);
    });
    setDesignState_(r, DESIGN.APPROVED);
    saveRequest_(r);
    logActivity_(requestId, user.email, 'Approved', 'Design approved' + ((Number(r.designRound) || 0) ? ' after Round ' + r.designRound : '') + '.');
    refreshRequestStatus_(requestId);
    return r;
  });
  try { notifyDesignApproved_(r, settings, people, user); } catch (e) { console.warn('Email: ' + e.message); }
  return { designState: r.designState };
}

function apiDesignFeedback(requestId, answers, files) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  var clean = validateAnswers_(FORMS.feedback, answers || {});
  var r0 = findRequest_(requestId);
  assertOwnerOrAdmin_(user, r0);
  if (r0.designState !== DESIGN.IN_REVIEW) throw new Error('Feedback can be sent when a draft is waiting for your review.');

  var link = '';
  if (files && files.length) {
    var folder = ensureRequestFolder_(r0, settings, people);
    saveFiles_(folder, files);
    link = folder.getUrl();
  }
  var text = '[' + clean.kind + '] ' + clean.text + (link ? '\nFiles: ' + link : '');
  var included = Number(settings['Included revision rounds']) || 0;

  var out = withLock_(function () {
    var r = findRequest_(requestId);
    tasksFor_(requestId).forEach(function (t) { if (t.status === TASK.OPEN && t.key === 'review') completeTask_(t, user.email); });
    var next = (Number(r.designRound) || 0) + 1;
    var held = included && next > included;
    logActivity_(requestId, user.email, 'Feedback', 'Round ' + next + (held ? ' (held — over ' + included + ' included rounds)' : '') + ': ' + text, link);
    var task = null;
    if (held) {
      r.heldFeedback = text;
      setDesignState_(r, DESIGN.HELD);
    } else {
      task = startRound_(r, next, text, settings, people);
    }
    saveRequest_(r);
    return { r: r, held: held, task: task, text: text };
  });

  try { notifyFeedback_(out.r, out.text, out.held, settings, people, user); } catch (e) { console.warn('Email: ' + e.message); }
  return { held: out.held, designState: out.r.designState, round: out.r.designRound };
}

function startRound_(r, round, text, settings, people) {
  var d = designerFor_(r, settings, people);
  var turnaround = Number(settings['Revision turnaround days']) || 3;
  r.designRound = String(round);
  r.heldFeedback = '';
  setDesignState_(r, DESIGN.REVISING);
  return addTask_(r, {
    suffix: 'R' + round, dueDate: addDaysIso(todayIso_(), turnaround), owner: d.owner, key: 'revision',
    assigneeEmail: d.email, task: 'Round ' + round + ' revisions: ' + String(text).replace(/^\[[^\]]*\]\s*/, '').slice(0, 80)
  });
}

/** Admin decides on feedback beyond the included rounds. */
function apiReleaseHeldFeedback(requestId, allow, note) {
  var settings = readSettings_();
  var people = readPeople_();
  var user = currentUser_(people);
  assertAdmin_(user);
  var out = withLock_(function () {
    var r = findRequest_(requestId);
    if (r.designState !== DESIGN.HELD) throw new Error('No feedback is being held.');
    var text = r.heldFeedback;
    if (allow) {
      startRound_(r, (Number(r.designRound) || 0) + 1, text, settings, people);
    } else {
      r.heldFeedback = '';
      setDesignState_(r, DESIGN.IN_REVIEW);
      r.messageToRequester = String(note || 'We have used the included design rounds for this request. Please approve the current version or talk with the communications team.');
      addTask_(r, { suffix: 'V' + r.designRound + 'b', dueDate: addDaysIso(todayIso_(), 3), owner: 'Leader', key: 'review',
        assigneeEmail: lc_(r.requesterEmail), task: 'Approve the current design (extra rounds were not approved)' });
    }
    saveRequest_(r);
    logActivity_(requestId, user.email, 'Feedback', allow ? 'Extra round approved.' : 'Extra round declined. ' + (note || ''));
    return { r: r, text: text };
  });
  try {
    if (allow) notifyFeedback_(out.r, out.text, false, settings, people, user);
    else notifyMessage_(out.r, settings, people);
  } catch (e) { console.warn('Email: ' + e.message); }
  return { designState: out.r.designState };
}

// ===== Calendar.gs =====

/**
 * Calendar.gs — keeps the shared Master calendar in step with approved requests.
 * One all-day event per request (a span for sermon series), plus the 14-day
 * Sprint window for Level 1.
 */

var TIER_SHORT = { 'Level 1': 'L1', 'Level 2': 'L2', 'Level 3': 'L3', 'Level 4': 'L4', 'Series': 'Series', 'Design': 'Design' };

function masterCalendar_(settings) {
  var id = calendarIdFrom_(settings['Master calendar ID']);
  if (!id) return null;
  var cal = CalendarApp.getCalendarById(id);
  if (!cal) throw new Error('Could not open the Master calendar (' + id + '). Is it shared with the app owner?');
  return cal;
}

/** Accepts a plain calendar ID or a calendar link containing ?cid=… */
function calendarIdFrom_(s) {
  s = String(s || '').trim();
  var m = /[?&]cid=([^&]+)/.exec(s);
  if (m) s = decodeURIComponent(m[1]);
  return /@/.test(s) ? s : '';
}

function removeCalendar_(r, settings) {
  var cal = masterCalendar_(settings);
  if (!cal || !r.calendarIds) return;
  splitList_(r.calendarIds).forEach(function (id) {
    try { var ev = cal.getEventById(id); if (ev) ev.deleteEvent(); } catch (e) { console.warn('Remove event ' + id + ': ' + e.message); }
  });
  r.calendarIds = '';
}

/** Replaces this request's events. Caller saves the request (calendarIds changes). */
function syncCalendar_(r, settings) {
  var cal = masterCalendar_(settings);
  if (!cal) return;
  removeCalendar_(r, settings);
  if ([STATUS.PLANNED, STATUS.DONE].indexOf(r.status) < 0) return;
  var tier = r.tier || r.suggestedTier;
  var title = '[' + (TIER_SHORT[tier] || tier) + '] ' + r.title;
  var desc = [r.requestId, r.ministry, r.requester, r.timeLocation, r.oneNextStep].filter(String).join('\n') +
    (ScriptApp.getService().getUrl() ? '\n\n' + ScriptApp.getService().getUrl() + '?request=' + encodeURIComponent(r.requestId) : '');
  var ids = [];
  var start = parseIsoDate(r.eventDate);
  if (tier === 'Series') {
    var weeks = Math.max(1, parseInt(r.seriesWeeks, 10) || 1);
    var end = parseIsoDate(addDaysIso(r.eventDate, 7 * (weeks - 1) + 1));
    ids.push(cal.createAllDayEvent(title, start, end, { description: desc }).getId());
  } else {
    ids.push(cal.createAllDayEvent(title, start, { description: desc }).getId());
  }
  if (tier === 'Level 1') {
    ids.push(cal.createAllDayEvent('[L1 Sprint] ' + r.title, parseIsoDate(addDaysIso(r.eventDate, -14)), start, { description: 'Sprint window\n' + desc }).getId());
  }
  r.calendarIds = ids.join(',');
}

// ===== Notify.gs =====

/**
 * Notify.gs — every email the app sends, in your brand colors.
 */

function esc_(s) {
  return String(s === undefined || s === null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
function escBr_(s) { return esc_(s).replace(/\n/g, '<br>'); }

function appLink_(requestId) {
  var url = ScriptApp.getService().getUrl() || '';
  return url && requestId ? url + '?request=' + encodeURIComponent(requestId) : url;
}

function isRealEmail_(e) { return /@/.test(e || '') && !/@example\./i.test(e); }

function send_(settings, opts) {
  var to = [].concat(opts.to || []).map(lc_).filter(isRealEmail_);
  to = to.filter(function (e, i) { return to.indexOf(e) === i; });
  if (!to.length) return;
  var cc = [].concat(opts.cc || []).map(lc_).filter(function (e) { return isRealEmail_(e) && to.indexOf(e) < 0; });
  var msg = {
    to: to.join(','), subject: opts.subject, name: settings['Brand header text'] || 'Communications',
    htmlBody: boldWeekdays(wrapEmail_(opts.html, settings))
  };
  if (cc.length) msg.cc = cc.join(',');
  if (opts.replyTo && isRealEmail_(opts.replyTo)) msg.replyTo = opts.replyTo;
  MailApp.sendEmail(msg);
}

function color_(v, fallback) { return /^#[0-9a-f]{3,8}$/i.test(String(v || '').trim()) ? String(v).trim() : fallback; }

function wrapEmail_(inner, s) {
  var head = color_(s['Brand header color'], '#00b5e2');
  var headInk = color_(s['Brand header text color'], '#ffffff');
  return '<div style="font-family:Georgia,serif;font-size:15px;color:#1d2733;max-width:640px">' +
    '<div style="background:' + head + ';color:' + headInk + ';padding:16px 20px;border-radius:8px 8px 0 0;font:700 17px Helvetica,Arial,sans-serif">' +
    esc_(s['Brand header text'] || 'Communications') + '</div>' +
    '<div style="border:1px solid #dfe4ea;border-top:0;padding:20px;border-radius:0 0 8px 8px">' + inner + '</div>' +
    (s['Brand footer text'] ? '<p style="font-size:12px;color:#66727f;text-align:center">' + esc_(s['Brand footer text']) + '</p>' : '') + '</div>';
}

function button_(href, label, s) {
  if (!href) return '';
  return '<p style="margin:20px 0"><a href="' + esc_(href) + '" style="background:' + color_(s['Brand accent color'], '#00b5e2') +
    ';color:#fff;padding:11px 18px;border-radius:6px;text-decoration:none;display:inline-block;font:600 14px Helvetica,Arial,sans-serif">' + esc_(label) + '</a></p>';
}

function rows_(pairs) {
  return '<table style="border-collapse:collapse;font-size:14px;width:100%">' + pairs.filter(function (p) { return p[1]; }).map(function (p) {
    return '<tr><td style="padding:5px 10px 5px 0;color:#66727f;vertical-align:top;white-space:nowrap">' + esc_(p[0]) + '</td><td style="padding:5px 0">' + escBr_(p[1]) + '</td></tr>';
  }).join('') + '</table>';
}

function taskTable_(tasks, people) {
  if (!tasks.length) return '';
  return '<table style="border-collapse:collapse;font-size:13px;width:100%">' + tasks.map(function (t) {
    return '<tr><td style="padding:6px 10px 6px 0;border-bottom:1px solid #eef1f4;white-space:nowrap;vertical-align:top">' + esc_(prettyIso(t.dueDate)) + '</td>' +
      '<td style="padding:6px 0;border-bottom:1px solid #eef1f4">' + esc_(t.task) +
      (people ? '<br><span style="color:#66727f;font-size:12px">' + esc_(t.channel) + ' · ' + esc_(nameOf_(t.assigneeEmail, people)) + '</span>' : '') + '</td></tr>';
  }).join('') + '</table>';
}

function adminEmails_(people) { return emailsWithRole_(ROLES.ADMIN, people); }

/* ---------------- request lifecycle ---------------- */

function notifySubmitted_(r, s, people) {
  send_(s, {
    to: r.requesterEmail,
    subject: 'Request received: ' + r.title + ' (' + r.requestId + ')',
    html: '<p>Thanks, ' + esc_(String(r.requester).split(' ')[0]) + '! We received your request. The communications team will review it, set the tier and build your plan.</p>' +
      (r.flags ? '<p style="background:#fff3dd;color:#9a5b00;padding:10px 12px;border-radius:6px">' + esc_(r.flags) + '. We will do our best; rushed requests may get a lighter plan.</p>' : '') +
      rows_([['Request', r.requestId], ['Type', r.requestType], ['Date', prettyIso(r.eventDate)], ['Suggested tier', r.suggestedTier]]) +
      button_(appLink_(r.requestId), 'View your request', s)
  });
  send_(s, {
    to: adminEmails_(people), replyTo: r.requesterEmail,
    subject: 'New request to review: ' + r.title + ' (' + r.suggestedTier + ')',
    html: '<p>' + esc_(r.requester) + ' submitted a new request.</p>' +
      rows_([['Request', r.requestId], ['Ministry', r.ministry], ['Type', r.requestType], ['Date', prettyIso(r.eventDate)], ['Suggested tier', r.suggestedTier], ['Flags', r.flags]]) +
      button_(appLink_(r.requestId), 'Review it', s)
  });
}

function notifyReviewed_(r, s, people) {
  var tasks = readTable_(TABLES.TASKS).filter(function (t) { return t.requestId === r.requestId && t.status === TASK.OPEN; });
  if (r.status === STATUS.PLANNED) {
    var mine = tasks.filter(function (t) { return lc_(t.assigneeEmail) === lc_(r.requesterEmail); });
    send_(s, {
      to: r.requesterEmail,
      subject: 'Approved: ' + r.title + ' — ' + r.tier,
      html: '<p>Your request is approved as <b>' + esc_(r.tier) + '</b> (' + esc_(r.mode) + ').</p>' +
        (r.messageToRequester ? '<p>' + escBr_(r.messageToRequester) + '</p>' : '') +
        (mine.length ? '<h3 style="font:600 15px Helvetica,Arial">Your part</h3>' + taskTable_(mine) : '') +
        button_(appLink_(r.requestId), 'See the full plan', s)
    });
    if (/^yes/i.test(r.needsDesign)) sendBrief_(r, tasks, s, people);
    // Pastor and others with tasks hear about theirs.
    var others = {};
    tasks.forEach(function (t) {
      var e = lc_(t.assigneeEmail);
      if (e && e !== lc_(r.requesterEmail) && adminEmails_(people).indexOf(e) < 0 && emailsWithRole_(ROLES.DESIGNER, people).indexOf(e) < 0) (others[e] = others[e] || []).push(t);
    });
    Object.keys(others).forEach(function (e) {
      send_(s, { to: e, subject: 'New tasks: ' + r.title, html: '<p>You have tasks for <b>' + esc_(r.title) + '</b>.</p>' + taskTable_(others[e]) + button_(appLink_(r.requestId), 'Open in the app', s) });
    });
  } else {
    send_(s, {
      to: r.requesterEmail,
      subject: (r.status === STATUS.NEEDS_INFO ? 'More info needed: ' : 'Update on your request: ') + r.title,
      html: '<p>' + (r.status === STATUS.NEEDS_INFO ? 'We need a little more information before we can plan <b>' + esc_(r.title) + '</b>.' : 'We are not able to take on <b>' + esc_(r.title) + '</b> as requested.') + '</p>' +
        (r.messageToRequester ? '<p style="background:#e6f7fc;padding:12px;border-radius:6px">' + escBr_(r.messageToRequester) + '</p>' : '') +
        button_(appLink_(r.requestId), 'Open your request', s)
    });
  }
}

/** The design brief: everything the designer needs in one email. */
function sendBrief_(r, tasks, s, people) {
  var d = designerFor_(r, s, people);
  if (d.owner !== 'Designer') return; // in-house design: the communications team already has it
  var mine = tasks.filter(function (t) { return lc_(t.assigneeEmail) === lc_(d.email); });
  send_(s, {
    to: d.email, cc: adminEmails_(people), replyTo: r.requesterEmail,
    subject: 'Design brief: ' + r.title + ' (' + r.tier + ')' + (mine.length ? ' — first draft ' + prettyIso(mine[0].dueDate) : ''),
    html: '<p>Hi ' + esc_(String(d.name).split(' ')[0]) + ', here is a new design brief. Reply to reach ' + esc_(r.requester) + ' directly.</p>' +
      (r.flags ? '<p style="background:#fff3dd;color:#9a5b00;padding:10px 12px;border-radius:6px">' + esc_(r.flags) + '</p>' : '') +
      '<h3 style="font:600 15px Helvetica,Arial">Your deadlines</h3>' + taskTable_(mine) +
      '<h3 style="font:600 15px Helvetica,Arial">The brief</h3>' +
      rows_([['Request', r.title + ' (' + r.requestId + ')'], ['Requested by', r.requester], ['Ministry', r.ministry], ['Tier', r.tier + ' · ' + r.mode],
        ['Date', prettyIso(r.eventDate)], ['Who for', r.whoFor], ['Big idea', r.bigIdea], ['Scripture', r.scripture],
        ['Weeks', r.seriesWeeks], ['Weekly titles', r.weeklyTitles], ['Story', r.story],
        ['One next step', [r.nextStepType, r.oneNextStep].filter(String).join(' — ')], ['Time & location', r.timeLocation],
        ['Details', r.details], ['Design items', r.designItems], ['Specs', r.designSpecs], ['Text to include', r.textToInclude],
        ['Text final?', r.textFinal], ['Visual direction', r.visualDirection], ['Inspiration', r.inspiration], ['Anything else', r.anythingElse],
        ['Files', r.designFolder]]) +
      button_(appLink_(r.requestId), 'Open in the app', s)
  });
}

function notifyChange_(r, text, cancel, s, people, user) {
  var to = adminEmails_(people);
  if (cancel && /^yes/i.test(r.needsDesign)) to = to.concat(emailsWithRole_(ROLES.DESIGNER, people));
  send_(s, {
    to: to, replyTo: user.email,
    subject: (cancel ? 'Cancelled: ' : 'Change request: ') + r.title,
    html: '<p>' + esc_(nameOf_(user.email, people)) + (cancel ? ' cancelled ' : ' sent a change for ') + '<b>' + esc_(r.title) + '</b>.</p>' +
      '<p style="background:#f7f9fa;padding:12px;border-radius:6px">' + escBr_(text) + '</p>' +
